{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras",
      "models": {
        "gemma-4-31b": {
          "name": "Gemma 4 31B",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "gpt-oss-120b": {
          "name": "GPT OSS 120B",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "zai-glm-4.7": {
          "name": "ZAI GLM 4.7",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      },
      "options": {
        "baseURL": "https://api.cerebras.ai/v1"
      }
    }
  },
  "permission": {
    "external_directory": "deny",
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean -*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  }
}
