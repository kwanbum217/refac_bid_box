# ============================================================
# Databases (runtime files)
# ============================================================
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
# Redis 스냅샷. 워커/캐시를 띄울 때마다 갱신되는 런타임 산출물입니다.
dump.rdb
*.rdb
appendonly.aof
appendonlydir/

# DB 덤프와 백업 아카이브. GB 단위 이진 파일이라 저장소에 담지 않습니다.
# 체크섬(data/backups/data_assets_checksums.json)만 추적해 무결성을 검증합니다.
data/backups/*.sql
data/backups/*.sql.gz
data/backups/*.tar.gz

# ============================================================
# Caches / logs / runtime
# ============================================================
logs/
*.log
*.pid
*.seed
*.pid.lock
.cache/
*.cache

# ============================================================
# ML artifacts — large binaries (track via Git LFS or external store)
# ============================================================
# Model weights
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.pickle
*.bin
*.joblib
*.safetensors
*.gguf
*.ckpt
*.pb
# Vector DB runtime data
chroma_db/
chroma/
# ML model registry (runtime artifacts — trainer output)
ml_registry/
*.faiss
# CatBoost training logs
catboost_info/
# Data exports / snapshots
data/exports/
*.parquet
# 데이터셋 캐시 산출물(src/ml/dataset.py). parquet 외 조사 결과 CSV 도 재생성 대상입니다.
data/feature_store/
# 측정 산출물(잔차 parquet, 키 조사 CSV). 스크립트로 재생성되며 정본은 docs/design/ 입니다.
data/analysis/
# 모델 승격 시 직전 서빙본을 옮겨 두는 롤백용 백업입니다(src/ml/promotion.py).
# 승격마다 덮어써지는 런타임 산출물이며 정본은 data/model_files/ 가 추적합니다.
data/model_backups/
*.arrow
# Large binaries
*.exe
*.dll
*.so
*.dylib

