# refac_bid_box 환경 변수 세이프티 템플릿
# 주의: 실제 시크릿 키나 운영 환경 비밀번호는 본 파일에 절대 유출하지 마십시오.

# 애플리케이션 기본 설정
ENVIRONMENT=development
DEBUG=False
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# 데이터베이스 (MySQL 8)
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/procurement
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=procurement

# Redis 캐시 및 Arq 브로커
REDIS_URL=redis://localhost:6379/0

# Meilisearch 검색 전용 읽기 모델. 실제 키는 충분히 긴 무작위 값만 .env에 둡니다.
MEILI_ENABLED=false
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# 나라장터 공공데이터 API. 기존 serviceKey 이름도 읽지만 새 설정은 이 이름을 사용합니다.
G2B_SERVICE_KEY=
# 개발 스택은 수집·KB·집계 최신화를 매일 수행합니다. 전체 검증·재학습은 운영에서만 켭니다.
AUTOMATION_DATA_REFRESH_SCHEDULE_ENABLED=true
AUTOMATION_NIGHTLY_SCHEDULE_ENABLED=false
ML_WEEKLY_RETRAIN_ENABLED=false

# 생성 LLM 백엔드 (ollama | gemini)
# 기본은 로컬 Ollama 로, 발표 시 네트워크와 API 키 의존을 제거합니다.
# 주의: 여기서 바꾸는 것은 생성 LLM 뿐입니다. ChromaDB 임베딩 모델은
# 보존된 bidding_kb 임베딩과의 정합성 때문에 교체 금지입니다 (G1 데이터 무손실).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# 원본 bid_box 경로 복원용 (LLM_PROVIDER=gemini 일 때 사용)
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB 벡터 저장소 (임베딩 모델 교체 금지)
CHROMA_DB_PATH=chroma_db

# MLOps & 가중치 경로
MODEL_REGISTRY_DIR=ml_registry
FEATURE_STORE_DIR=data/feature_store
