# ============================================================
# refac_bid_box — 환경변수 예시
# 사용 전 복사하여 .env 로 만들고 실제 값으로 채우세요.
#   cp .env.example .env
# .env 파일은 절대 커밋하지 마세요 (.gitignore 에서 제외됨).
# ============================================================

# ---- Application ----
APP_ENV=development            # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-secret
APP_DEBUG=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# 운영/공통: MySQL / MariaDB
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=procurement
DB_USER=root
DB_PASSWORD=
# 개발 fallback (지정 시 SQLite 사용)
# DB_ENGINE=sqlite

# ---- LLM (Google Gemini) ----
GEMINI_API_KEY=

# ---- G2B / 나라장터 공공데이터 API ----
G2B_SERVICE_KEY=

# ---- Vector DB (RAG) ----
CHROMA_DB_PATH=chroma_db

# ---- Social Login (django-allauth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- MLOps / Automation (Harness) ----
HARNESS_ACCOUNT_ID=
HARNESS_API_KEY=
HARNESS_PIPELINE_ID=
