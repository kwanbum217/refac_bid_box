# refac_bid_box 환경 변수 세이프티 템플릿
# 주의: 실제 시크릿 키나 운영 환경 비밀번호는 본 파일에 절대 유출하지 마십시오.

# 애플리케이션 기본 설정
# development | staging | production 중 하나만 허용됩니다.
ENVIRONMENT=development
DEBUG=False
# SSR 상태 변경 폼의 CSRF 이중 제출 토큰 검증. 보안상 기본값은 활성입니다.
CSRF_PROTECTION_ENABLED=true
# 32자 이상의 무작위 값을 사용하십시오. 예제 값을 운영에 사용하면 시동이 거부됩니다.
SECRET_KEY=change-this-in-production-to-a-secure-random-key
# 자격증명(쿠키) 요청을 허용할 오리진 목록입니다. 콤마로 구분하고 스킴을 포함합니다.
# ENVIRONMENT=production 에서는 비워 둘 수 없고 와일드카드도 쓸 수 없습니다.
# 개발에서는 비워 두면 CORS_DEV_ALLOW_ALL 정책을 따르고, 값을 채우면 그 목록만 허용합니다.
CORS_ALLOWED_ORIGINS=
# 개발·스테이징에서만 유효합니다. production 에서는 이 값과 무관하게 목록만 허용합니다.
CORS_DEV_ALLOW_ALL=true
# Docker Compose app 서비스의 Uvicorn 워커 프로세스 수. 안전 기본값은 1입니다.
# 실제 Docker 재기동 실측에서 3워커(c10 P95 127.32ms)와 4워커(c10 P95 165.92ms)
# 모두 100ms 목표에 실패해 다중 워커 기본값 채택을 철회했습니다. 3워커 이상은
# 수동 실험 옵션으로만 사용하십시오.
# 상세 실측치와 기각 판정은 docs/ops/uvicorn_worker_scaling_candidate_20260813.md 참조.
WEB_CONCURRENCY=1

# 데이터베이스 (MySQL 8)
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/procurement
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=procurement
# Docker Compose의 개발용 MySQL root 비밀번호입니다. DB_PASSWORD와 같은 값으로
# 유지하고, 운영에서는 두 값을 모두 반드시 교체하십시오.
MYSQL_ROOT_PASSWORD=rootpassword

# Redis 캐시 및 Arq 브로커
REDIS_URL=redis://localhost:6379/0
WORKER_HEARTBEAT_INTERVAL_SECONDS=30

# Meilisearch 검색 전용 읽기 모델. Compose 기동 전 16자 이상의 무작위 값을
# .env에 설정해야 하며, 빈 값이면 구성 단계에서 실패합니다.
MEILI_ENABLED=false
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# 나라장터 공공데이터 API. 기존 serviceKey 이름도 읽지만 새 설정은 이 이름을 사용합니다.
G2B_SERVICE_KEY=
# 개발 스택은 수집·KB·집계 최신화를 매일 수행합니다. 전체 검증·재학습은 운영에서만 켭니다.
AUTOMATION_DATA_REFRESH_SCHEDULE_ENABLED=true
AUTOMATION_NIGHTLY_SCHEDULE_ENABLED=false
ML_WEEKLY_RETRAIN_ENABLED=false
# PSI 드리프트 모니터링 정기 검사(매일 04:00) 활성화 여부입니다.
# baseline 분포 아티팩트가 없는 초기 상태에서의 오경보를 방지하기 위해 기본값은 비활성입니다.
ML_DRIFT_MONITOR_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
BACKUP_RETENTION_COUNT=7

# 생성 LLM 백엔드 (ollama | gemini)
# 기본은 로컬 Ollama 로, 발표 시 네트워크와 API 키 의존을 제거합니다.
# 주의: 여기서 바꾸는 것은 생성 LLM 뿐입니다. ChromaDB 임베딩 모델은
# 보존된 bidding_kb 임베딩과의 정합성 때문에 교체 금지입니다 (G1 데이터 무손실).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# 원본 bid_box 경로 복원용 (LLM_PROVIDER=gemini 일 때 사용)
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB 벡터 저장소 (임베딩 모델 교체 금지)
CHROMA_DB_PATH=chroma_db

# MLOps & 가중치 경로
MODEL_REGISTRY_DIR=ml_registry
FEATURE_STORE_DIR=data/feature_store

# 인증 보안 및 DoS 방어
# 로그인 시도 제한 임계값과 잠금 시간(초)
AUTH_RATE_LIMIT_IP_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_ACCOUNT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=300
# 요청 본문 크기 상한(바이트)
MAX_REQUEST_BODY_SIZE=10485760
# 익명 챗봇 API 요청 쿼터(IP별 요청 횟수 및 윈도우 초)
ANONYMOUS_API_RATE_LIMIT_MAX_REQUESTS=30
ANONYMOUS_API_RATE_LIMIT_WINDOW_SECONDS=60
# 신뢰 프록시 목록(쉼표 구분 IP 또는 CIDR).
# 리버스 프록시나 로드밸런서를 앞에 두면 반드시 그 주소를 여기에 넣으십시오.
# 비워 두면 X-Forwarded-For 를 신뢰하지 않고 TCP 피어 주소를 씁니다. 프록시
# 뒤에서 이 값을 비우면 모든 요청이 프록시 IP 하나로 보여 IP 축 시도 제한이
# 전체 사용자 잠금으로 바뀝니다.
TRUSTED_PROXY_IPS=

# readiness 게이트 승격 여부. 기본값에서 warmup 미완료와 LLM 미가용은 degraded 입니다.
READINESS_REQUIRE_WARMUP=false
READINESS_REQUIRE_LLM=false
