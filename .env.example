# refac_bid_box 환경 변수 설정 템플릿
# 주의: 실제 비밀값이나 운영 환경의 시크릿 키는 본 파일에 절대 유출하지 마십시오.

# ==============================================================================
# 1. 애플리케이션 설정 (Application Settings)
# ==============================================================================

# 기본 환경 및 보안
# 실행 환경 (development, staging, production 중 하나)
ENVIRONMENT=development
# 디버그 모드 활성화 여부
DEBUG=false
# 애플리케이션 및 워커 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# SSR 상태 변경 폼의 CSRF 이중 제출 토큰 검증 활성화 여부
CSRF_PROTECTION_ENABLED=true
# 세션 서명 및 암호화에 사용되는 32자 이상의 시크릿 키
SECRET_KEY=change-this-in-production-to-a-secure-random-key
# CORS 허용 오리진 목록 (쉼표로 구분된 도메인 문자열)
CORS_ALLOWED_ORIGINS=
# 개발 및 스테이징 환경에서 모든 오리진을 허용할지 여부
CORS_DEV_ALLOW_ALL=true

# 데이터베이스 (MySQL 8)
# SQLAlchemy 연결용 데이터베이스 URL
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/procurement
# MySQL 서버 호스트 주소
DB_HOST=localhost
# MySQL 서버 접속 포트
DB_PORT=3306
# MySQL 접속 사용자 이름
DB_USER=root
# MySQL 접속 비밀번호
DB_PASSWORD=rootpassword
# 데이터베이스 스키마 이름
DB_NAME=procurement
# 집계 쿼리에 MySQL ngram FULLTEXT 선행필터 적용 여부
NGRAM_PREFILTER_ENABLED=false

# Redis 캐시 및 Arq 태스크 브로커
# Redis 캐시 및 태스크 큐 접속 URL
REDIS_URL=redis://localhost:6379/0
# Arq 워커 생존 하트비트 기록 주기 (초 단위)
WORKER_HEARTBEAT_INTERVAL_SECONDS=30

# 검색 엔진 (Meilisearch)
# 검색 전용 Meilisearch 읽기 모델 활성화 여부
MEILI_ENABLED=false
# Meilisearch 인스턴스 서버 URL
MEILI_URL=http://localhost:7700
# Meilisearch 인증용 마스터 API 키
MEILI_MASTER_KEY=
# Meilisearch HTTP 요청 타임아웃 (초 단위)
MEILI_TIMEOUT_SECONDS=5.0

# LLM & RAG 설정
# 질의응답 및 의도 분류에 사용할 생성 LLM 백엔드 제공자 (ollama 또는 gemini)
LLM_PROVIDER=ollama
# LLM 응답 생성 요청 타임아웃 (초 단위)
LLM_TIMEOUT_SECONDS=120.0
# LLM 텍스트 생성 다양성 제어용 온도값
LLM_TEMPERATURE=0.2
# Ollama 모델의 사고(thinking) 출력 단계 활성화 여부
LLM_THINKING=false
# 애플리케이션 기동 시 LLM 모델 사전 적재 여부
LLM_WARMUP_ON_STARTUP=true
# Ollama 로컬 서비스 API 엔드포인트 URL
OLLAMA_BASE_URL=http://localhost:11434
# 기본 Ollama LLM 모델 이름
OLLAMA_MODEL=gemma4:e2b
# Ollama 모델의 메모리 상주 유지 시간 (-1은 무기한)
OLLAMA_KEEP_ALIVE=-1
# 기동 시 ChromaDB 컬렉션 및 임베딩 연결 사전 예열 여부
VECTOR_WARMUP_ON_STARTUP=true
# 벡터 유사도 검색용 텍스트 임베딩 제공자 (ollama 또는 default)
EMBEDDING_PROVIDER=ollama
# RAG 임베딩 모델 이름
EMBEDDING_MODEL=bge-m3
# ChromaDB 데이터 디렉터리 경로
CHROMA_DB_PATH=chroma_db
# Google Gemini 대체 모델 이름
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Google Gemini API 인증 키
GEMINI_API_KEY=
# RAG 응답 메타데이터에 구간별 계측 지표 포함 여부
RAG_EXPOSE_SEGMENT_METRICS=false
# RAG 답변에서 필수 수치 누락 여부 검출 및 기록 활성화 여부
NUMERIC_OMISSION_DETECTION=false
# 진단용 구간별 레이턴시 계측 로그 출력 활성화 여부
LATENCY_SEGMENT_LOGGING=false

# 자동화 및 정기 스케줄
# 최근 성공 이력이 있는 고비용 자동화 작업의 재실행 건너뛰기 여부
AUTOMATION_REUSE_RECENT=true
# 워커가 웹 애플리케이션과 동일한 데이터베이스를 공유하는지 여부
AUTOMATION_WORKER_SHARES_DB=true
# 분리된 워커 환경에서 웹 앱으로 진행 상태를 보고할 콜백 URL
AUTOMATION_CALLBACK_BASE_URL=
# 매일 02:00 공고 수집 및 지표 최신화 스케줄 활성화 여부
AUTOMATION_DATA_REFRESH_SCHEDULE_ENABLED=true
# 매일 02:00 야간 전체 예측 검증 및 재학습 스케줄 활성화 여부
AUTOMATION_NIGHTLY_SCHEDULE_ENABLED=false
# 워커 기동 시 누락된 일일 정기 수집 따라잡기 실행 여부
AUTOMATION_SCHEDULE_CATCHUP_ENABLED=false
# 스케줄 따라잡기 실행 판정 기준 경과 시간 (시간 단위)
AUTOMATION_SCHEDULE_CATCHUP_THRESHOLD_HOURS=24
# 스케줄 따라잡기 재시도 방지 쿨다운 시간 (시간 단위)
AUTOMATION_SCHEDULE_CATCHUP_COOLDOWN_HOURS=6
# 매일 03:00 정기 통합 백업 스케줄 활성화 여부
BACKUP_SCHEDULE_ENABLED=false
# 보존할 최대 백업 스냅샷 수
BACKUP_RETENTION_COUNT=7
# 백업 스토리지 최소 안전 여유 디스크 공간 (GB 단위)
BACKUP_DISK_MIN_FREE_GB=5.0

# ML 모델 관리 및 MLOps
# 서빙용 머신러닝 모델 가중치 파일 디렉터리 경로
MODEL_FILES_DIR=data/model_files
# 모델 승격 시 이전 서빙 가중치를 보관하는 백업 디렉터리 경로
MODEL_BACKUPS_DIR=data/model_backups
# 모델 평가 및 서빙 실측 메트릭 사이드카 파일 디렉터리 경로
MODEL_METRICS_DIR=data/model_metrics
# 모델 아티팩트 및 메타데이터 레지스트리 디렉터리 경로
MODEL_REGISTRY_DIR=ml_registry
# 재학습용 오프라인 특징 저장소 디렉터리 경로
FEATURE_STORE_DIR=data/feature_store
# 매주 월요일 03:00 주간 모델 재학습 스케줄 활성화 여부
ML_WEEKLY_RETRAIN_ENABLED=true
# 매일 04:00 PSI 데이터 드리프트 감지 스케줄 활성화 여부
ML_DRIFT_MONITOR_ENABLED=true
# MLOps 경보 및 상태 알림 발송용 웹훅 URL
MLOPS_WEBHOOK_URL=

# 인증 보안 및 서비스 보호
# 신뢰할 수 있는 리버스 프록시 IP 또는 CIDR 목록 (쉼표 구분)
TRUSTED_PROXY_IPS=
# IP 축 로그인 시도 최대 허용 횟수
AUTH_RATE_LIMIT_IP_MAX_ATTEMPTS=10
# 계정 축 로그인 시도 최대 허용 횟수
AUTH_RATE_LIMIT_ACCOUNT_MAX_ATTEMPTS=5
# 로그인 연속 실패 시 계정 및 IP 잠금 시간 (초 단위)
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=300
# HTTP 요청 본문 최대 허용 크기 (바이트 단위)
MAX_REQUEST_BODY_SIZE=10485760
# 익명 챗봇 API 클라이언트당 최대 요청 횟수
ANONYMOUS_API_RATE_LIMIT_MAX_REQUESTS=30
# 익명 챗봇 API 요청 제한 시간 윈도우 (초 단위)
ANONYMOUS_API_RATE_LIMIT_WINDOW_SECONDS=60

# 헬스체크 및 Readiness 승격
# 예열 완료 전까지 Readiness 헬스체크를 503(not ready)으로 처리할지 여부
READINESS_REQUIRE_WARMUP=false
# LLM 서비스 연결 전까지 Readiness 헬스체크를 503(not ready)으로 처리할지 여부
READINESS_REQUIRE_LLM=false

# OpenTelemetry 관측성 설정
# OpenTelemetry 분산 추적 및 메트릭 활성화 여부
OTEL_ENABLED=false
# OpenTelemetry 계측 서비스 이름
OTEL_SERVICE_NAME=refac_bid_box
# OpenTelemetry 익스포터 유형 (none, console, otlp)
OTEL_EXPORTER_TYPE=none
# OTLP 수집기 엔드포인트 URL
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# 트레이스 헤드 샘플링 비율 (0.0 ~ 1.0)
OTEL_SAMPLING_RATIO=1.0
# OpenTelemetry 메트릭 수집 활성화 여부 (비워 둘 시 OTEL_ENABLED 설정 추종)
OTEL_METRICS_ENABLED=
# OpenTelemetry 메트릭 내보내기 주기 (밀리초 단위)
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=60000


# ==============================================================================
# 2. 컨테이너 인프라 설정 (Container Infrastructure Settings)
# ==============================================================================

# Docker Compose 환경의 MySQL root 관리자 비밀번호
MYSQL_ROOT_PASSWORD=rootpassword
# Docker Compose Uvicorn 워커 프로세스 동시 실행 수
WEB_CONCURRENCY=1
# Grafana 관리자 대시보드 로그인 비밀번호
GF_SECURITY_ADMIN_PASSWORD=
# 나라장터 공공데이터 수집 API 서비스 인증 키
G2B_SERVICE_KEY=
# Alertmanager SLO critical 알람 수신용 Slack 웹훅 URL
ALERTMANAGER_SLACK_WEBHOOK_URL=
# 운영 워커 healthcheck가 하트비트를 유효하다고 인정하는 최대 경과 시간 (초 단위)
WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
