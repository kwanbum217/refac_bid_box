{
  "threshold": 5,
  "reporters": [
    "console",
    "html"
  ],
  "format": [
    "python",
    "javascript",
    "typescript"
  ],
  "min-lines": 5,
  "min-tokens": 50,
  "path": [
    "src/",
    "frontend/src/"
  ],
  "ignore": [
    "**/.venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/data/**",
    "**/chroma_db/**",
    "**/node_modules/**",
    "**/reports/**",
    "**/migrations/**",
    "**/src/app/services/evaluation_rules_history.py",
    "**/src/app/services/evaluation_quant_institution.py"
  ],
  "output": "./reports/jscpd",
  "absolute": true
}
