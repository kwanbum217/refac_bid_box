{
    auto_https off
}

{$TLS_DOMAIN} {
    tls {$TLS_CERT_FILE} {$TLS_KEY_FILE}
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy app:8000
}
